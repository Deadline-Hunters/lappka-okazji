{
  "name": "lappka-okazji",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "mobile": "npm run start --workspace=@lappka-okazji/mobile",
    "mobile:android": "npm run android --workspace=@lappka-okazji/mobile",
    "mobile:ios": "npm run ios --workspace=@lappka-okazji/mobile",
    "mobile:web": "npm run web --workspace=@lappka-okazji/mobile",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.122.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

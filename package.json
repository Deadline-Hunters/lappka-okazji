{
  "name": "lappka-okazji",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "typecheck": "npm run typecheck --workspace=@lappka-okazji/mobile",
    "db:types": "node scripts/db-types.mjs",
    "db:types:check": "node scripts/db-types.mjs --check",
    "mobile": "npm run start --workspace=@lappka-okazji/mobile",
    "mobile:android": "npm run android --workspace=@lappka-okazji/mobile",
    "mobile:ios": "npm run ios --workspace=@lappka-okazji/mobile",
    "mobile:web": "npm run web --workspace=@lappka-okazji/mobile",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown"
  }
}
